# Copy to .env and fill in. NEVER commit .env.

# --- The three values that choose the provider ---
# OpenRouter: https://openrouter.ai/api/v1   | Ollama: http://localhost:11434/v1/
LLM_BASE_URL=
# OpenRouter: your real key                  | Ollama: the literal string  ollama
LLM_API_KEY=
# OpenRouter: openrouter/free                | Ollama: gemma3:1b  (or llama3.2:3b)
LLM_MODEL=

# --- Behaviour switches ---
LLM_STUB=0            # 1 = never call the model, return a hard-coded valid object
LLM_ENABLED=true      # false = kill switch: no model call, deterministic fallback
LLM_TIMEOUT_MS=30000  # hard cap 60000
LLM_MAX_RETRIES=3     # own retry logic (SDK retries are disabled)
LLM_MAX_TOKENS=400
PROMPT_VERSION=v1     # loads prompts/triage-<version>.md
PORT=3000
